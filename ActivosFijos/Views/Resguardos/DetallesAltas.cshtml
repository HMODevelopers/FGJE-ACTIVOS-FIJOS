@model List<ActivosFijos.Models.ViewModels.DetalleAltasActivosViewModel>

@{
    ViewBag.Title = "Detalles Alta Activos";
    var indice = 1;
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Folio Alta</th>
                            <th>Numero Inventario</th>
                            <th>Categoria</th>
                            <th>Descripción</th>
                            <th>Numero Serie</th>
                            <th>Marca</th>
                            <th>Fecha Alta</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@indice</td>
                                <td class="text-center" width="15%">@item.FolioAlta</td>
                                <td class="text-center" width="30%">@item.NumeroInventario</td>
                                <td class="text-center">@item.Categoria</td>
                                <td class="text-center" width="20%">@item.Descripcion</td>
                                <td class="text-center">@item.NumeroSerie</td>
                                <td class="text-center">@item.Marca</td>
                                <td class="text-center">@item.FechaAlta.ToString("yyyy-MM-dd")</td>
                            </tr>
                            indice++;
                        }
                    </tbody>
                </table>
                <button type="button" class="btn btn-info waves-effect" id="cerrar" onclick="window.location.href='@Url.Action("ListarAltas", "Resguardos")';">Atras</button>
            </div>
        </div>
    </div>
</div>
