@model PagedList.IPagedList<ActivosFijos.Models.ViewModels.EmpleadoSinInventarioHistoricoViewModel>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Número empleado</th>
                <th>Nombre completo</th>
                <th>Corporación</th>
                <th>Área</th>
                <th>Puesto funcional</th>
                <th>Municipio</th>
                <th>Activos asignados</th>
                <th>Resguardos</th>
                <th>Fecha primer activo asignado</th>
                <th>Estatus</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var empleado in Model)
                {
                    <tr>
                        <td>@empleado.NumeroEmpleado</td>
                        <td>@empleado.NombreCompleto</td>
                        <td>@(string.IsNullOrWhiteSpace(empleado.Corporacion) ? "Sin adscripción" : empleado.Corporacion)</td>
                        <td>@(string.IsNullOrWhiteSpace(empleado.Area) ? "Sin adscripción" : empleado.Area)</td>
                        <td>@(string.IsNullOrWhiteSpace(empleado.PuestoFuncional) ? "Sin dato" : empleado.PuestoFuncional)</td>
                        <td>@(string.IsNullOrWhiteSpace(empleado.Municipio) ? "Sin dato" : empleado.Municipio)</td>
                        <td>@empleado.TotalActivosAsignados</td>
                        <td>@empleado.TotalResguardos</td>
                        <td>@(empleado.FechaPrimerActivoAsignado.HasValue ? empleado.FechaPrimerActivoAsignado.Value.ToString("dd/MM/yyyy") : "Sin fecha")</td>
                        <td><span class="badge badge-danger">@empleado.Estatus</span></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center text-muted">No se encontraron empleados con activos sin inventario histórico.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model != null)
{
    <div class="container-fluid">
        <div class="row mt-3">
            <div class="col-sm-8 col-12">
                <span>Empleados del <strong>@(Model.LastItemOnPage > 0 ? Model.FirstItemOnPage : 0)</strong> al <strong>@Model.LastItemOnPage</strong> de <strong>@Model.TotalItemCount</strong> Registros</span>
            </div>
            <div class="col-sm-12 col-12 text-right">
                <div id="pagedList" class="pagedList">
                    @Html.PagedListPager(Model, iPaginaSinInventario => Url.Action("Index", new { iPaginaSinInventario, iPerPageSinInventario = ViewBag.PerPageSinInventario, numeroEmpleadoSinInventario = ViewBag.NumeroEmpleadoSinInventario, nombreCompletoSinInventario = ViewBag.NombreCompletoSinInventario, corporacionSinInventario = ViewBag.CorporacionSinInventario, areaSinInventario = ViewBag.AreaSinInventario, puestoFuncionalSinInventario = ViewBag.PuestoFuncionalSinInventario, municipioSinInventario = ViewBag.MunicipioSinInventario }), PagedList.Mvc.PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(PagedListRenderOptions.ClassicPlusFirstAndLast, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "resultadosBusquedaSinInventario", OnBegin = "ShowLoading", OnComplete = "HideLoading" }))
                </div>
            </div>
        </div>
    </div>
}
