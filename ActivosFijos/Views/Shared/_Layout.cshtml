<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Inventario FGJE | @ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="A fully featured admin theme which can be used to build CRM, CMS, etc." name="description" />
    <meta content="Coderthemes" name="author" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="~/Content/assets/images/favicon.ico">

    <!-- plugin css -->
    <link href="~/Content/assets/libs/jquery-vectormap/jquery-jvectormap-1.2.2.css" rel="stylesheet" type="text/css" />
    <!-- Lightbox css -->
    <link href="~/Content/assets/libs/magnific-popup/magnific-popup.css" rel="stylesheet" type="text/css" />

    <!-- App css -->
    <link href="~/Content/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/assets/css/app.min.css" rel="stylesheet" type="text/css" />

    <!-- DATATABLE party css -->
    <link href="~/Content/assets/libs/datatables/dataTables.bootstrap4.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/assets/libs/datatables/responsive.bootstrap4.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/assets/libs/datatables/buttons.bootstrap4.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/assets/libs/datatables/select.bootstrap4.css" rel="stylesheet" type="text/css" />
    <!-- DATATABLE party css end -->
    <!-- Sweet Alert-->
    <link href="~/Content/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
    <!-- Sweet Alert-->
    <link href="~/Content/Loader.css" rel="stylesheet" />
    <link href="~/Content/assets/css/lightbox.min.css" rel="stylesheet" />
    <link href="~/Content/PagedList.css" rel="stylesheet" />
    <link href="~/Content/assets/libs/select2/select2.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/apexcharts@latest/dist/apexcharts.css">

    <!-- Bootstrap CSS -->
    @RenderSection("styles", required: false)

</head>

<body class="left-side-menu-light topbar-dark">

    <!-- Begin page -->
    <div id="wrapper">

        <div class="wrapper-loader fade" id="LoadingImage" style="display: none;">
            <div class="loader">
                <div class="loader__figure"></div>
                <p class="loader__label">Cargando...</p>
            </div>
        </div>

        @Html.Partial("topbar")

        @Html.Partial("left_sidebar")
        <!-- ============================================================== -->
        <!-- Start Page Content here -->
        <!-- ============================================================== -->

        <div class="content-page">
            <div class="content">

                <!-- Start Content-->
                <div class="container-fluid">

                    <!-- start page title -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <div class="page-title-right">
                                    <ol class="breadcrumb m-0">
                                        <li class="breadcrumb-item"><a href="javascript: void(0);">Inicio</a></li>
                                        <li class="breadcrumb-item"><a href="javascript: void(0);">@ViewBag.Title</a></li>
                                        <li class="breadcrumb-item active">@ViewBag.Title</li>
                                    </ol>
                                </div>
                                <h4 class="page-title">@ViewBag.Title</h4>
                            </div>
                        </div>
                    </div>
                    <!-- end page title -->
                    @RenderBody()

                </div> <!-- container -->

            </div> <!-- content -->
            <!-- Footer Start -->
            @Html.Partial("footer")
            <!-- end Footer -->

        </div>

        <!-- ============================================================== -->
        <!-- End Page content -->
        <!-- ============================================================== -->


    </div>
    <script src="~/Content/assets/js/lightbox-plus-jquery.min.js"></script>
    <!-- END wrapper -->
    <!-- Vendor js -->
    <script src="~/Content/assets/js/vendor.min.js"></script>

    <script src="~/Content/assets/libs/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Content/assets/libs/datatables/dataTables.bootstrap4.js"></script>
    <script src="~/Content/assets/libs/datatables/dataTables.responsive.min.js"></script>
    <script src="~/Content/assets/libs/datatables/responsive.bootstrap4.min.js"></script>
    <script src="~/Content/assets/libs/datatables/dataTables.buttons.min.js"></script>
    <script src="~/Content/assets/libs/datatables/buttons.bootstrap4.min.js"></script>
    <script src="~/Content/assets/libs/datatables/buttons.html5.min.js"></script>
    <script src="~/Content/assets/libs/datatables/buttons.flash.min.js"></script>
    <script src="~/Content/assets/libs/datatables/buttons.print.min.js"></script>
    <script src="~/Content/assets/libs/datatables/dataTables.keyTable.min.js"></script>
    <script src="~/Content/assets/libs/datatables/dataTables.select.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
    <!-- third party js ends -->
    <!--SweetAlert-->
    <script src="~/Content/assets/libs/sweetalert2/sweetalert2.min.js"></script>
    <!--End SweetAlert-->
    <!-- Magnific Popup-->
    @*<script src="~/Content/assets/libs/magnific-popup/jquery.magnific-popup.min.js"></script>*@

    <!-- Tour init js-->
    @*<script src="~/Content/assets/js/pages/lightbox.init.js"></script>*@

    <!-- App js -->
    <script src="~/Content/assets/js/app.min.js"></script>


    <script src="~/Content/assets/js/jquery.validate.min.js"></script>
    <script src="~/Content/assets/js/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/Content/assets/js/jquery.form.js"></script>
    <script src="~/Content/assets/js/Loader.js"></script>
    <script src="~/Content/assets/js/CatchForm.js"></script>
    <script src="~/Content/assets/js/pdf-helper.js"></script>
    <script src="~/Content/assets/libs/select2/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@latest"></script>
    <script src="~/Content/assets/js/pako.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
