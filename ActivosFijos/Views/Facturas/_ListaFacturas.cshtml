@model PagedList.IPagedList<ActivosFijos.Models.PLU_CAT_Facturas>
@using PagedList.Mvc;

@{
    string folioFactura = ViewBag.FolioFactura as string;
    string fechaDesdeS = ViewBag.FechaDesde != null ? ((DateTime)ViewBag.FechaDesde).ToString("yyyy-MM-dd") : null;
    string fechaHastaS = ViewBag.FechaHasta != null ? ((DateTime)ViewBag.FechaHasta).ToString("yyyy-MM-dd") : null;
    int? idProveedor = ViewBag.IdProveedor as int?;
    int? idRecurso = ViewBag.IdRecurso as int?;
}

<div class="row">
    <div class="col-md-12">
        @Html.Raw($"<a type='button' href='{Url.Action("Agregar")}' class='btn btn-success waves-effect waves-light'><i class='icon-plus mr-1'></i> Agregar Factura</a>")
    </div>
</div>
<br />
@if (Model.Count > 0)
{


    <table class="table table-bordered">
        <tr>
            <th>
                @Ajax.ActionLink("#", "Index", new { sOrder = ViewBag.IdFacturaSortParam, FolioFactura = folioFactura, IdProveedor = idProveedor, IdRecurso = idRecurso, FechaDesde = fechaDesdeS, FechaHasta = fechaHastaS, iPerPage = ViewBag.PerPage, iPagina = 1 }, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "resultadosBusqueda", OnBegin = "ShowLoading", OnComplete = "HideLoading" })
                <i class="mdi mdi-sort"></i>
            </th>
            <th>
                @Ajax.ActionLink("Folio Factura", "Index", new { sOrder = ViewBag.FolioFacturaSortParam, FolioFactura = folioFactura, IdProveedor = idProveedor, IdRecurso = idRecurso, FechaDesde = fechaDesdeS, FechaHasta = fechaHastaS, iPerPage = ViewBag.PerPage, iPagina = 1 }, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "resultadosBusqueda", OnBegin = "ShowLoading", OnComplete = "HideLoading" })
                <i class="mdi mdi-sort"></i>
            </th>
            <th>Proveedor</th>
            <th>Recurso</th>
            <th>Total</th>
            <th>Estatus</th>
            <th>Fecha Factura</th>
            <th><label></label>Acciones</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.IdFactura)</td>
                <td><strong>@Html.DisplayFor(modelItem => item.FolioFactura)</strong></td>
                <td>@Html.DisplayFor(modelItem => item.PLU_CAT_Proveedores.RazonSocial)</td>
                <td>@Html.DisplayFor(modelItem => item.PLU_CAT_Recursos.NombreRecurso)</td>
                <td>@Html.DisplayFor(modelItem => item.Total)</td>
                <td class="text-center">
                    @{
                        string sColor = "";
                        if (item.Activo == false)
                        {
                            sColor = "text-danger";
                        }
                        else if (item.Activo == true)
                        {
                            sColor = "text-success";
                        }
                    }

                    <i class="mdi mdi-checkbox-blank-circle @sColor"></i>
                </td>
                <td>@Html.DisplayFor(modelItem => item.FechaFactura)</td>
                <td>
                    <center>
                        <a href="@Url.Action("Editar", new { id = item.IdFactura })" class="btn btn-primary"><i class="icon-pencil"></i></a>

                    </center>
                </td>
            </tr>
        }
    </table>


    <div class="container-fluid">
        <div class="row mt-3">

            <div class="col-sm-8 col-12">
                <span>Activos del <strong>@(Model.LastItemOnPage > 0 ? Model.FirstItemOnPage : 0)</strong> al  <strong>@Model.LastItemOnPage</strong> de <strong>@Model.TotalItemCount</strong> Registros</span>
            </div>
            <div class="col-12 text-right">
                <div id="pagedList" class="pagedList" data-otf-target="#IndexList">
                    @Html.PagedListPager(Model, iPagina => Url.Action("Index", new { iPagina, iPerPage = ViewBag.PerPage, sOrder = ViewBag.Order, FolioFactura = folioFactura, IdProveedor = idProveedor, IdRecurso = idRecurso, FechaDesde = fechaDesdeS, FechaHasta = fechaHastaS }), PagedList.Mvc.PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(PagedListRenderOptions.ClassicPlusFirstAndLast,
                          new AjaxOptions
                               {
                              HttpMethod = "get",
                              InsertionMode = InsertionMode.Replace,
                              UpdateTargetId = "resultadosBusqueda",
                              OnBegin = "ShowLoading",
                              OnComplete = "HideLoading"
                          }))
                </div>
            </div>

        </div>
    </div>


}
else
{
    <p>No se encontraron resultados.</p>
}
