<div class="card-header" style="border-color:darkgray; border-style:dotted;">
    <h5>Filtros</h5>

    <div class="row">
        <div class="col-lg-12">
            @using (Ajax.BeginForm("Index", "Facturas", new AjaxOptions { HttpMethod = "GET", UpdateTargetId = "resultadosBusqueda", OnBegin = "ShowLoading", OnComplete = "HideLoading" }))
            {
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="field-1" class="control-label">Folio Factura</label>
                            <div class="input-group">
                                @Html.TextBox("FolioFactura", ViewBag.FolioFactura as string, new { @class = "form-control filtrar" })
                                <div class="input-group-append clean-filter">
                                    <span class="input-group-text">
                                        <i class="mdi mdi-close-circle text-danger"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="IdProveedor" class="control-label">Proveedor</label>
                            <div class="input-group">
                                @Html.DropDownList("IdProveedor", ViewBag.Proveedores as SelectList, "-- Seleccione un Proveedor --", new { @class = "form-control filtrar" })
                                <div class="input-group-append clean-filter">
                                    <span class="input-group-text">
                                        <i class="mdi mdi-close-circle text-danger"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="IdRecurso" class="control-label">Recurso</label>
                            <div class="input-group">
                                @Html.DropDownList("IdRecurso", ViewBag.Recursos as SelectList, "-- Seleccione un Recurso --", new { @class = "form-control filtrar" })
                                <div class="input-group-append clean-filter">
                                    <span class="input-group-text">
                                        <i class="mdi mdi-close-circle text-danger"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label">Fecha Desde</label>
                            <div class="input-group">
                                @Html.TextBox("FechaDesde",
                                    ViewBag.FechaDesde != null ? ((DateTime)ViewBag.FechaDesde).ToString("yyyy-MM-dd") : null,
                                    new { @class = "form-control filtrar", @type = "date" })
                                <div class="input-group-append clean-filter">
                                    <span class="input-group-text">
                                        <i class="mdi mdi-close-circle text-danger"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label">Fecha Hasta</label>
                            <div class="input-group">
                                @Html.TextBox("FechaHasta",
                                    ViewBag.FechaHasta != null ? ((DateTime)ViewBag.FechaHasta).ToString("yyyy-MM-dd") : null,
                                    new { @class = "form-control filtrar", @type = "date" })
                                <div class="input-group-append clean-filter">
                                    <span class="input-group-text">
                                        <i class="mdi mdi-close-circle text-danger"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-9 text-right align-self-end">
                        <button type="button" class="btn btn-primary filtrar">Filtrar</button>
                        <a href="@Url.Action("Index", "Facturas")" class="btn btn-secondary">Limpiar</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
