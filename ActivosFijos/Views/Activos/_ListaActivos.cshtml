@model PagedList.IPagedList<ActivosFijos.Models.PLU_OP_Activos>

@{
    // AjaxOptions centralizado
    var ajax = new System.Web.Mvc.Ajax.AjaxOptions
    {
        HttpMethod = "GET",
        InsertionMode = System.Web.Mvc.Ajax.InsertionMode.Replace,
        UpdateTargetId = "resultadosBusqueda",
        OnBegin = "ShowLoading",
        OnComplete = "HideLoading"
    };
}

@if (Model != null && Model.Count > 0)
{
    <div class="table-responsive">
        <div class="row">
            <div class="col-md-12">
                @Html.Raw($"<a type='button' href='{Url.Action("Agregar")}' class='btn btn-success waves-effect waves-light'><i class='icon-plus mr-1'></i> Agregar Activo</a>")
            </div>
        </div>
        <br />

        <table class="table table-bordered" width="100%">
            <tr>
                <th>
                    @Ajax.ActionLink("#", "Index",
                        new
                             {
                            Orden = ViewBag.IdActivosSortParam,
                            numeroinventario = ViewBag.NumeroInvetario,
                            descripcion = ViewBag.Descripcion,
                            IdCategoria = ViewBag.Categoria,
                            IdConcepto = ViewBag.Concepto,
                            NumeroSerie = ViewBag.NumeroSerie,
                            IdAlmacen = ViewBag.Almacen,
                            IdEstadoFisico = ViewBag.EstadosFisicos,
                            IdEstatusActivo = ViewBag.EstatusActivos,
                            iPerPage = ViewBag.PerPage,
                            iPagina = 1
                        },
                        ajax)
                    <i class="mdi mdi-sort"></i>
                </th>

                <th>
                    @Ajax.ActionLink("Número de Inventario", "Index",
                        new
                             {
                            Orden = ViewBag.NumeroInventarioSortParm,
                            numeroinventario = ViewBag.NumeroInvetario,
                            descripcion = ViewBag.Descripcion,
                            IdCategoria = ViewBag.Categoria,
                            IdConcepto = ViewBag.Concepto,
                            NumeroSerie = ViewBag.NumeroSerie,
                            IdAlmacen = ViewBag.Almacen,
                            IdEstadoFisico = ViewBag.EstadosFisicos,
                            IdEstatusActivo = ViewBag.EstatusActivos,
                            iPerPage = ViewBag.PerPage,
                            iPagina = 1
                        },
                        ajax)
                    <i class="mdi mdi-sort"></i>
                </th>

                <th>
                    @Ajax.ActionLink("Descripción", "Index",
                        new
                             {
                            Orden = ViewBag.DescripcionSortParm,
                            numeroinventario = ViewBag.NumeroInvetario,
                            descripcion = ViewBag.Descripcion,
                            IdCategoria = ViewBag.Categoria,
                            IdConcepto = ViewBag.Concepto,
                            NumeroSerie = ViewBag.NumeroSerie,
                            IdAlmacen = ViewBag.Almacen,
                            IdEstadoFisico = ViewBag.EstadosFisicos,
                            IdEstatusActivo = ViewBag.EstatusActivos,
                            iPerPage = ViewBag.PerPage,
                            iPagina = 1
                        },
                        ajax)
                    <i class="mdi mdi-sort"></i>
                </th>

                <th>
                    @Ajax.ActionLink("Categoria", "Index",
                        new
                             {
                            Orden = ViewBag.CategoriaSortParm,
                            numeroinventario = ViewBag.NumeroInvetario,
                            descripcion = ViewBag.Descripcion,
                            IdCategoria = ViewBag.Categoria,
                            IdConcepto = ViewBag.Concepto,
                            NumeroSerie = ViewBag.NumeroSerie,
                            IdAlmacen = ViewBag.Almacen,
                            IdEstadoFisico = ViewBag.EstadosFisicos,
                            IdEstatusActivo = ViewBag.EstatusActivos,
                            iPerPage = ViewBag.PerPage,
                            iPagina = 1
                        },
                        ajax)
                    <i class="mdi mdi-sort"></i>
                </th>

                <th>
                    @Ajax.ActionLink("Concepto", "Index",
                        new
                             {
                            Orden = ViewBag.ConceptoSortParm,
                            numeroinventario = ViewBag.NumeroInvetario,
                            descripcion = ViewBag.Descripcion,
                            IdCategoria = ViewBag.Categoria,
                            IdConcepto = ViewBag.Concepto,
                            NumeroSerie = ViewBag.NumeroSerie,
                            IdAlmacen = ViewBag.Almacen,
                            IdEstadoFisico = ViewBag.EstadosFisicos,
                            IdEstatusActivo = ViewBag.EstatusActivos,
                            iPerPage = ViewBag.PerPage,
                            iPagina = 1
                        },
                        ajax)
                    <i class="mdi mdi-sort"></i>
                </th>

                <th>
                    @Ajax.ActionLink("Clasificador", "Index",
                        new
                             {
                            Orden = ViewBag.ClasificadorSortParm,
                            numeroinventario = ViewBag.NumeroInvetario,
                            descripcion = ViewBag.Descripcion,
                            IdCategoria = ViewBag.Categoria,
                            IdConcepto = ViewBag.Concepto,
                            NumeroSerie = ViewBag.NumeroSerie,
                            IdAlmacen = ViewBag.Almacen,
                            IdEstadoFisico = ViewBag.EstadosFisicos,
                            IdEstatusActivo = ViewBag.EstatusActivos,
                            iPerPage = ViewBag.PerPage,
                            iPagina = 1
                        },
                        ajax)
                    <i class="mdi mdi-sort"></i>
                </th>

                <th>
                    @Ajax.ActionLink("Estado Fisico", "Index",
                        new
                             {
                            Orden = ViewBag.EstadoFisocoSortParam,
                            numeroinventario = ViewBag.NumeroInvetario,
                            descripcion = ViewBag.Descripcion,
                            IdCategoria = ViewBag.Categoria,
                            IdConcepto = ViewBag.Concepto,
                            NumeroSerie = ViewBag.NumeroSerie,
                            IdAlmacen = ViewBag.Almacen,
                            IdEstadoFisico = ViewBag.EstadosFisicos,
                            IdEstatusActivo = ViewBag.EstatusActivos,
                            iPerPage = ViewBag.PerPage,
                            iPagina = 1
                        },
                        ajax)
                    <i class="mdi mdi-sort"></i>
                </th>

                <th>Estatus Activo</th>
                <th>Acciones</th>
            </tr>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(m => item.IdActivos)</td>
                    <td><strong>@Html.DisplayFor(m => item.NumeroInventario)</strong></td>
                    <td>@Html.DisplayFor(m => item.Descripcion)</td>
                    <td>@Html.DisplayFor(m => item.PLU_CAT_CategoriaActivo.NombreCategoria)</td>
                    <td>@Html.DisplayFor(m => item.PLU_CAT_Conceptos.NombreConcepto)</td>
                    <td>@Html.DisplayFor(m => item.PLU_CAT_Clasificadores.ClasificadorDescripcion)</td>
                    <td>@Html.DisplayFor(m => item.PLU_CAT_EstadoFisicoActivo.Descripcion)</td>
                    <td class="text-center">
                        @{
                            var sColor = item.IdEstatusActivo == 1 ? "text-danger"
                                       : item.IdEstatusActivo == 3 ? "text-success"
                                       : "";
                        }
                        <i class="mdi mdi-checkbox-blank-circle @sColor"></i>
                    </td>
                    <td>
                        <center>
                            <div class="btn-group dropdown">
                                <a href="javascript:void(0);" class="btn btn-success waves-effect waves-light table-action-btn dropdown-toggle arrow-none btn btn-light btn-sm" data-toggle="dropdown" aria-expanded="false"><i class="icon-options"></i></a>
                                <div class="dropdown-menu dropdown-menu-right">
                                    @Html.Raw($"<a href='{Url.Action("Detalles", new { id = item.IdActivos })}' class='dropdown-item'><i class='icon-eye mr-2 text-muted font-18 vertical-middle'></i>Detalle Activo</a>")

                                    @if (item.IdEstatusActivo == 1)
                                    {
                                        @Html.Raw($"<a href='javascript:void(0);' class='dropdown-item' onclick='backToAlmacen({item.IdActivos})'><i class=\"icon-action-undo mr-2 text-muted font-18 vertical-middle\"></i>Regreso Almacen</a>")
                                    }

                                    @if (item.IdEstatusActivo == 3)
                                    {
                                        @Html.Raw($"<a href='{Url.Action("Editar", new { id = item.IdActivos })}' class='dropdown-item'><i class='icon-pencil mr-2 text-muted font-18 vertical-middle'></i>Editar Activo</a>")
                                        @Html.Raw($"<a href='{Url.Action("Baja", new { id = item.IdActivos })}' class='dropdown-item'><i class='icon-trash mr-2 text-muted font-18 vertical-middle'></i>Baja Activo</a>")
                                        @Html.Raw($"<a href='{Url.Action("ImprimirEtiqueta", "Activos", new { id = item.IdActivos })}' class='dropdown-item' target='_blank'><i class='icon-printer mr-2 text-muted font-18 vertical-middle'></i>Imprimir etiqueta pequeña</a>")
                                        @Html.Raw($"<a href='{Url.Action("ImprimirEtiquetaGrande", "Activos", new { id = item.IdActivos })}' class='dropdown-item' target='_blank'><i class='icon-printer mr-2 text-muted font-18 vertical-middle'></i>Imprimir etiqueta grande</a>")
                                    }
                                </div>
                            </div>
                        </center>
                    </td>
                </tr>
            }
        </table>

        <div class="container-fluid">
            <div class="row mt-3">
                <div class="col-sm-8 col-12">
                    <span>
                        Activos del <strong>@(Model.LastItemOnPage > 0 ? Model.FirstItemOnPage : 0)</strong>
                        al <strong>@Model.LastItemOnPage</strong>
                        de <strong>@Model.TotalItemCount</strong> Registros
                    </span>
                </div>
                <div class="col-12 text-right">
                    <div id="pagedList" class="pagedList" data-otf-target="#IndexList">
                        @Html.PagedListPager(
                            Model,
                            iPagina => Url.Action("Index", new
                                 {
                                iPagina,
                                iPerPage = ViewBag.PerPage,
                                Orden = ViewBag.Order,
                                numeroinventario = ViewBag.NumeroInvetario,
                                descripcion = ViewBag.Descripcion,
                                IdCategoria = ViewBag.Categoria,
                                IdConcepto = ViewBag.Concepto,
                                NumeroSerie = ViewBag.NumeroSerie,
                                IdAlmacen = ViewBag.Almacen,
                                IdEstadoFisico = ViewBag.EstadosFisicos,
                                IdEstatusActivo = ViewBag.EstatusActivos
                            }),
                            PagedList.Mvc.PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(
                                PagedListRenderOptions.ClassicPlusFirstAndLast,
                                ajax
                            )
                        )
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <p>No se encontraron resultados.</p>
}
