@using Newtonsoft.Json

@{
    ViewBag.Title = "Carga Masiva";
}

<div class="row">
    <div class="col-lg-12">
        <div class="alert alert-primary">
            <h5 class="m-1">Nota:</h5>
            <p class="m-2">
                El campo donde colocaremos el archivo solo admite archivos de tipo Excel con extensión .xls o .xlsx.
            </p>
        </div>
        <div class="row">
            <div class="col-lg-3">
                <div class="card">
                    <div class="card-body">
                        @using (Html.BeginForm("CargarArchivo", "Activos", FormMethod.Post, new { name = "cargamasivaform", id = "cargamasivaform", enctype = "multipart/form-data" }))
                        {
                            <div class="form-group">
                                <label>Layout Excel</label>
                                <input type="file" name="file" id="file" class="form-control" accept=".xls,.xlsx,.csv" />
                            </div>
                            <a href="~/Content/Layout-Excel/Layout-Activos-Nuevos.xlsx" download>Descargar layout de ejemplo</a>
                            <br /><br />
                            <div class="modal-footer">
                                <button type="button" class="btn btn-danger waves-effect" id="Cancelar">Cancelar</button>
                                <button id="submitBtn" type="submit" class="btn btn-success waves-effect waves-light">Cargar</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="card">
                    <div class="card-body">
                        <div class="alert alert-info">
                            <h5 class="m-1">Vista Previa:</h5>
                            <p class="m-2">
                                En esta sección, se presentarán los datos que deseamos cargar. Una vez revisados y confirmados, procederemos a hacer clic en el botón 'Guardar' para iniciar el proceso de inserción en la base de datos de activos.
                            </p>
                        </div>
                        <div id="vista-previa">
                            <!-- Aquí se mostrará la tabla de vista previa -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div> <!-- end col-->
</div><!-- end row -->
@section Scripts {
    
    <script>
        $(document).ready(function () {

            $('#Cancelar').click(function () {
                window.location.reload(true);
            });


            const allowedExtensions = ['xls', 'xlsx', 'csv'];

            //validacion para el input file
            function validateFile() {
                const fileInput = $('#file');
                const submitBtn = $('#submitBtn');
                const file = fileInput[0].files[0];

                if (file) {
                    const fileName = file.name.toLowerCase();
                    const extension = fileName.split('.').pop();

                    if (allowedExtensions.includes(extension)) {
                        submitBtn.prop('disabled', false);
                        return true;

                    } else {

                        Swal.fire({
                            title: "¡Error!",
                            text: 'Archivo no permitido. Por favor, suba un archivo con una de las siguientes extensiones: ' + allowedExtensions.join(', '),
                            type: "error"
                        }).then(function (result) {
                            submitBtn.prop('disabled', true);
                            return false;
                        });

                    }

                } else {

                    Swal.fire({
                        title: "¡Error!",
                        text: 'Por favor, suba un archivo con una de las siguientes extensiones: ' + allowedExtensions.join(', '),
                        type: "error"
                    }).then(function (result) {
                        submitBtn.prop('disabled', true);
                        return false;
                    });

                }
            }

            //cada que sufra un cambio lo valida
            $('#file').on('change', validateFile);

            //cargar el file por medio de ajax para pasar el archivo que insertamos.
            $('#cargamasivaform').submit(function (event) {
                event.preventDefault();

                if (!validateFile()) {
                    return;
                }

                var formData = new FormData(this);

                $.ajax({
                    url: $(this).attr('action'),
                    type: $(this).attr('method'),
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (result) {

                        $('#vista-previa').html(result);

                    },
                    error: function (xhr, status, error) {

                        Swal.fire({
                            title: "¡Error!",
                            text: `Error: ${xhr.status} ${error}. Por favor, intente de nuevo.`,
                            type: "error"
                        }).then(function (result) {
                            window.location.reload(true);
                        });

                    }
                });
            });

           $(document).on('click', '#guardarActivos', function () {
                let activos = [];

                // Construir el array de activos
                $('#vista-previa tbody tr').each(function () {
                    let activo = {};
                    $(this).find('td').each(function (index) {
                        let columnName = $(this).closest('table').find('th').eq(index).text();
                        activo[columnName] = $(this).text().trim();
                    });
                    activos.push(activo);
                });

                // Convertir el array a JSON
                let jsonString = JSON.stringify(activos);

                // Comprimir el JSON usando pako.js
                let compressedData = pako.deflate(jsonString);

                // Enviar los datos comprimidos al servidor
                $.ajax({
                    url: '@Url.Action("GuardarActivosMasivos", "Activos")',
                    type: 'POST',
                    data: compressedData,
                    processData: false,
                    contentType: 'application/octet-stream', // Indicar que no es JSON sino datos binarios
                    success: function (response) {
                        if (response.response) {
                            Swal.fire("¡Buen Trabajo!", response.message, "success").then(() => {
                                window.location.href = response.href;
                            });
                        } else {
                            Swal.fire("¡Error!", response.message, "error").then(() => {
                                window.location.reload(true);
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        alert("Error al guardar los activos: " + error);
                    }
                });
            });


        });
    </script>
}