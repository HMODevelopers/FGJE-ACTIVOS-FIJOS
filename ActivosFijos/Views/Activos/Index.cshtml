@model PagedList.IPagedList<ActivosFijos.Models.PLU_OP_Activos>


@{
    ViewBag.Title = "Activos Almacen";
}


@Html.Partial("_Filtros")


  <div class="card">
      <div class="card-body">
          <div id="resultadosBusqueda">
              <!-- Aquí se mostrarán los resultados de la búsqueda -->
              @Html.Partial("_ListaActivos", Model) <!-- Agregar esto para mostrar los resultados iniciales -->
          </div>
      </div>
 </div>

 @section Scripts {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-ajax-unobtrusive/3.2.6/jquery.unobtrusive-ajax.min.js"></script>
        <script src="~/Content/assets/js/pages/Filtros.js"></script>
        <script>


             function printLabels(id) {
                  // Abre una nueva ventana o pestaña para la vista de impresión
                   var printWindow = window.open('@Url.Action("ImprimirEtiqueta", "Activos")?id=' + id, '_blank');
                   printWindow.print();

            }

            function backToAlmacen(activoId) {

                Swal.fire({
                    title: '¿Estás seguro?',
                    text: "Esta acción no se puede deshacer.",
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sí, continuar',
                    cancelButtonText: 'Cancelar'

                }).then((result) => {
                    
                    if (result.value) {

                        $.ajax({
                            url: '@Url.Action("BackAlmacen", "Activos")', // URL para la acción en el controlador
                            type: 'POST', // Tipo de petición
                            data: { id: activoId }, // Datos a enviar
                            success: function(response) {
                                Swal.fire(
                                    '¡Hecho!',
                                    'El activo ha sido regresado al almacén.',
                                    'success'
                                ).then(() => {
                                    // Recargar la lista de activos o redirigir a la página principal
                                    // Si deseas recargar toda la página
                                    location.reload();

                                    // Si solo deseas recargar una sección específica
                                    // $("#resultadosBusqueda").load(location.href + " #resultadosBusqueda>*", "");
                                });
                            },
                            error: function(xhr, status, error) {
                                Swal.fire(
                                    'Error',
                                    'Ocurrió un error al procesar la solicitud.',
                                    'error'
                                );
                                // Manejo del error
                            }
                        });

                    }
                });
            }

        </script>
 }



