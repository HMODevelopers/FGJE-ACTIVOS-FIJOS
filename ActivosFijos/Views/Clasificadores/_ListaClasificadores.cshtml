@model PagedList.IPagedList<ActivosFijos.Models.PLU_CAT_Clasificadores>

@if (Model.Count > 0)
{
    <div class="row">
        <div class="col-md-12">
            <button class="btn btn-primary waves-effect waves-light" data-toggle="modal" data-target="#con-close-modal"><span><i class="la la-add"></i></span>Agregar Clasificadores</button>
        </div>
    </div>
    <br />
    <table class="table table-bordered">
        <tr>
            <th>
                @Ajax.ActionLink("#", "Index", new { sOrder = ViewBag.IdClasificadorSortParam, Clasificador = ViewBag.Clasificador, iPerPage = ViewBag.PerPage, iPagina = 1 }, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "resultadosBusqueda", OnBegin = "ShowLoading", OnComplete = "HideLoading" })
                <i class="mdi mdi-sort"></i>
            </th>
            <th>
                @Ajax.ActionLink("Nombre Clasificador", "Index", new { sOrder = ViewBag.NombreClasificadorSortParam, Clasificador = ViewBag.Clasificador, iPerPage = ViewBag.PerPage, iPagina = 1 }, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "resultadosBusqueda", OnBegin = "ShowLoading", OnComplete = "HideLoading" })
                <i class="mdi mdi-sort"></i>
            </th>
            <th>Activo</th>
            <th>Fecha Creación</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.IdClasificadores)</td>
                <td><strong>@Html.DisplayFor(modelItem => item.ClasificadorDescripcion)</strong></td>
                <td class="text-center">
                    @{
                        string sColor = "";
                        if (item.Activo == false)
                        {
                            sColor = "text-danger";
                        }
                        else if (item.Activo == true)
                        {
                            sColor = "text-success";
                        }
                    }

                    <i class="mdi mdi-checkbox-blank-circle @sColor"></i>
                </td>
                <td>@Html.DisplayFor(modelItem => item.FechaCreacion)</td>
            </tr>
        }
    </table>

    <div class="container-fluid">
        <div class="row mt-3">

            <div class="col-sm-8 col-12">
                <span>Activos del <strong>@(Model.LastItemOnPage > 0 ? Model.FirstItemOnPage : 0)</strong> al  <strong>@Model.LastItemOnPage</strong> de <strong>@Model.TotalItemCount</strong> Registros</span>
            </div>
            <div class="col-12 text-right">
                <div id="pagedList" class="pagedList" data-otf-target="#IndexList">
                    @Html.PagedListPager(Model, iPagina => Url.Action("Index", new { iPagina, iPerPage = ViewBag.PerPage, sOrder = ViewBag.Order, Clasificador = ViewBag.Clasificador }), PagedList.Mvc.PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(PagedListRenderOptions.ClassicPlusFirstAndLast,
                          new AjaxOptions
                               {
                              HttpMethod = "get",
                              InsertionMode = InsertionMode.Replace,
                              UpdateTargetId = "resultadosBusqueda",
                              OnBegin = "ShowLoading",
                              OnComplete = "HideLoading"
                          }))
                </div>
            </div>

        </div>
    </div>
}
else
{
    <p>No se encontraron resultados.</p>
}
