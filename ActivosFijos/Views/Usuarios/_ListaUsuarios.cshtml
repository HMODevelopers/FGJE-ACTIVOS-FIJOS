
@model PagedList.IPagedList<ActivosFijos.Models.PLU_CONF_Usuario>

@if (Model.Count > 0)
{
    <div class="table-responsive">
        <div class="row">
            <div class="col-md-12">
                @Html.Raw($"<a type='button' href='{Url.Action("Agregar")}' class='btn btn-success waves-effect waves-light'><i class='icon-plus mr-1'></i> Agregar Usuario</a>")
            </div>
        </div>
        <br />
        <table class="table table-bordered">
            <tr>
                <th>
                    @Ajax.ActionLink("#", "Index", new { sOrden = ViewBag.IdUsuarioSortParam,  }, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "resultadosBusqueda", OnBegin = "ShowLoading", OnComplete = "HideLoading" })
                    <i class="mdi mdi-sort"></i>
                </th>
                <th>
                    @Ajax.ActionLink("Nombre Usuario", "Index", new { sOrden = ViewBag.UsernameSortParam, }, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "resultadosBusqueda", OnBegin = "ShowLoading", OnComplete = "HideLoading" })
                    <i class="mdi mdi-sort"></i>
                </th>

                <th>
                    @Ajax.ActionLink("Nombres", "Index", new { sOrden = ViewBag.NombresSortParam, }, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "resultadosBusqueda", OnBegin = "ShowLoading", OnComplete = "HideLoading" })
                    <i class="mdi mdi-sort"></i>
                </th>

                <th>
                    @Ajax.ActionLink("Apellidos", "Index", new { sOrden = ViewBag.ApellidosSortParam,}, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "resultadosBusqueda", OnBegin = "ShowLoading", OnComplete = "HideLoading" })
                    <i class="mdi mdi-sort"></i>
                </th>

                <th>
                    @Ajax.ActionLink("Rol", "Index", new { sOrden = ViewBag.RolSortParam,}, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "resultadosBusqueda", OnBegin = "ShowLoading", OnComplete = "HideLoading" })
                    <i class="mdi mdi-sort"></i>
                </th>
                <th>Estatus</th>
                <th><label></label>Acciones</th>
            </tr>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.IdUsuario)</td>
                    <td><strong>@Html.DisplayFor(modelItem => item.Username)</strong></td>
                    <td>@Html.DisplayFor(modelItem => item.Nombres)</td>
                    <td>@Html.DisplayFor(modelItem => item.Apellidos)</td>
                    <td>@Html.DisplayFor(modelItem => item.PLU_CAT_Roles.NombreRol)</td>
                    <td class="text-center">
                        @{
                            string sColor = "";
                            if (item.Activo == false)
                            {
                                sColor = "text-danger";
                            }
                            else if (item.Activo == true)
                            {
                                sColor = "text-success";
                            }
                        }

                        <i class="mdi mdi-checkbox-blank-circle @sColor"></i>
                    </td>
                    <!-- Agrega más columnas aquí según tus necesidades -->
                    <td>
                        <center>
                            <a href="@Url.Action("Editar", new { id = item.IdUsuario })" class="btn btn-primary"><i class="icon-pencil"></i></a>
                            @using (Html.BeginForm("RestablecerPassword", "Usuarios", FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", item.IdUsuario)
                                <button type="submit" data-ajax="true" data-confirm="¿Desea restablecer la contraseña de este usuario?" class="btn btn-warning">
                                    <i class="mdi mdi-refresh"></i>
                                </button>
                            }
                        </center>
                    </td>
                </tr>
            }
        </table>


        <div class="container-fluid">
            <div class="row mt-3">

                <div class="col-sm-8 col-12">
                    <span>Activos del <strong>@(Model.LastItemOnPage > 0 ? Model.FirstItemOnPage : 0)</strong> al  <strong>@Model.LastItemOnPage</strong> de <strong>@Model.TotalItemCount</strong> Registros</span>
                </div>
                <div class="col-sm-4 col-12 text-right">
                    <div id="pagedList" class="pagedList" data-otf-target="#IndexList">
                        @Html.PagedListPager(Model, iPagina => Url.Action("Index", new { iPagina, iPerPage = ViewBag.PerPage, sOrden = ViewBag.Order, }), PagedList.Mvc.PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(PagedListRenderOptions.ClassicPlusFirstAndLast,
                              new AjaxOptions
                                   {
                                  HttpMethod = "get",
                                  InsertionMode = InsertionMode.Replace,
                                  UpdateTargetId = "resultadosBusqueda",
                                  OnBegin = "ShowLoading",
                                  OnComplete = "HideLoading"
                              }))
                    </div>
                </div>

            </div>
        </div>

    </div> <!-- end table-responsive-->
}
else
{
    <p>No se encontraron resultados.</p>
}
