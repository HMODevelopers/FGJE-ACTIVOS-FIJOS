@model ActivosFijos.Models.PLU_CONF_Usuario
@{
    ViewBag.Title = "Mi Perfil";
}

<div class="row">
    <div class="col-lg-12 col-xl-12">
        <div class="card-box text-center">
            <img src="~/Content/assets/images/users/user-1.jpg" class="rounded-circle avatar-lg img-thumbnail"
                 alt="profile-image">

            <h4 class="mb-0">@Html.DisplayFor(x => x.Nombres)</h4>
            <p class="text-muted">@Html.DisplayFor(x => x.Username)</p>

            <a href="@Url.Action("CambiarPassword", "Usuarios")" class="btn btn-success"><i class="mdi mdi-plus-circle-outline"></i> Cambiar Contraseña</a>

            <div class="text-left mt-3">

                <p class="text-muted mb-2 font-13"><strong>Nombre Completo :</strong> <span class="ml-2"> @Html.DisplayFor(x => x.Nombres) @Html.DisplayFor(x => x.Apellidos)</span></p>

                <p class="text-muted mb-2 font-13"><strong>Rol de Usuario :</strong><span class="badge badge-light-success badge-pill"> @Html.DisplayFor(x => x.PLU_CAT_Roles.NombreRol) </span></p>

                <p class="text-muted mb-2 font-13"><strong>Fecha Creacion :</strong> <span class="ml-2 ">@Html.DisplayFor(x => x.FechaCreacion)</span></p>

            </div>

        </div> <!-- end card-box -->
    </div>
</div>
