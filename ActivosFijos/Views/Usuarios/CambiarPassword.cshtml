@model ActivosFijos.Models.ViewModels.ChangePasswordViewModel
@{
    ViewBag.Title = "Cambiar Contraseña";
}

<div class="row">
    <div class="col-lg-12">
        <div class="alert alert-primary">
            <h6 class="m-0">Simbología:</h6>
            <p class="m-0">
                * Campos obligatorios
            </p>
        </div>
        <div class="card">
            <div class="card-body">
                @using (Html.BeginForm("CambiarPassword", "Usuarios", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(x => x.ReturnUrl)
                    <div class="modal-body p-4">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="CurrentPassword" class="control-label">Contraseña actual<span class="text-danger">*</span></label>
                                    @Html.PasswordFor(x => x.CurrentPassword, new { @class = "form-control", placeholder = "" })
                                    @Html.ValidationMessageFor(x => x.CurrentPassword, null, new { @class = "badge badge-danger" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="NewPassword" class="control-label">Nueva contraseña<span class="text-danger">*</span></label>
                                    @Html.PasswordFor(x => x.NewPassword, new { @class = "form-control", placeholder = "" })
                                    @Html.ValidationMessageFor(x => x.NewPassword, null, new { @class = "badge badge-danger" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="ConfirmPassword" class="control-label">Confirmar nueva contraseña<span class="text-danger">*</span></label>
                                    @Html.PasswordFor(x => x.ConfirmPassword, new { @class = "form-control", placeholder = "" })
                                    @Html.ValidationMessageFor(x => x.ConfirmPassword, null, new { @class = "badge badge-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-info waves-effect" id="cerrar" onclick="window.location.href='@Url.Action("Perfil", "Usuarios")';">Atras</button>
                        <button data-ajax="true" type="submit" class="btn btn-success waves-effect waves-light" id="guardar">Guardar</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
