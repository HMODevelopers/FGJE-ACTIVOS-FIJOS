@model List<ActivosFijos.Models.PLU_OP_InventarioFisico>

@{
    ViewBag.Title = "Detalle Inventario";
    var indice = 1;
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Numero Inventario</th>
                            <th>Descripción</th>
                            <th>Numero Serie</th>
                            <th>Empleado</th>
                            <th>Fecha Inventario</th>
                            <th>Estatus</th>
                            <th>Observación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@indice</td>
                                <td class="text-center" width="15%">@item.PLU_OP_Activos.NumeroInventario</td>
                                <td class="text-center" width="30%">@item.PLU_OP_Activos.Descripcion</td>
                                <td class="text-center">@item.PLU_OP_Activos.NumeroSerie</td>
                                <td class="text-center" width="20%">@item.PLU_OP_Activos.PLU_OP_Resguardo.PLU_OP_Empleados.NombreCompleto</td>
                                <td class="text-center">@item.FechaInventario.ToString("yyyy-MM-dd")</td>
                                <td class="text-center">
                                    @{

                                        if (item.Activo == true)
                                        {
                                            <span class="badge badge-light-success badge-pill">Encontrado</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-light-danger badge-pill">Pendiente</span>
                                        }
                                    }

                                </td>
                                <td class="text-center">@item.Observacion</td>


                            </tr>
                            indice++;
                        }
                    </tbody>
                </table>
                <button type="button" class="btn btn-info waves-effect" id="cerrar" onclick="window.location.href='@Url.Action("Inventarios", "Inventario")';">Atras</button>
            </div>
        </div>
    </div>
</div>
