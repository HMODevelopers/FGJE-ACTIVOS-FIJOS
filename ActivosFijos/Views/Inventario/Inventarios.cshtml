@model IPagedList<ActivosFijos.Models.ViewModels.InventariosViewModel>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Inventarios";
}

@Html.Partial("_Filtros")

<div class="row">
    <div class="col-lg-12">
        <div class="card">

            <div class="card-body">
                <div id="resultadosBusqueda">
                    <!-- Aquí se mostrarán los resultados de la búsqueda -->
                    @Html.Partial("_ListaInventarios", Model) <!-- Agregar esto para mostrar los resultados iniciales -->
                </div>
            </div>
        </div>
    </div> <!-- end col-->
</div><!-- end row -->

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-ajax-unobtrusive/3.2.6/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/Content/assets/js/pages/Filtros.js"></script>

    <script>

        function GenerarYAbrirPdf(NumeroEmpleado) {

        openPdfFromUrl('@Url.Action("GenerarPdf2", "Inventario")', { FolioInventario: NumeroEmpleado });
}
    </script>
}
