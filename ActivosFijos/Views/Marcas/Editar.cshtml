@model ActivosFijos.Models.PLU_CAT_MarcaActivo
@{
    ViewBag.Title = "Editar";
}

<div class="row">
    <div class="col-lg-12">
        <div class="alert alert-primary">
            <h6 class="m-0">Simbología:</h6>
            <p class="m-0">
                * Campos obligatorios
            </p>
        </div>
        <div class="card">
            <div class="card-body">
                @using (Html.BeginForm("Guardar", "Marcas", new AjaxOptions { HttpMethod = "POST", UpdateTargetId = "divMenu" }))
                {
                    <div class="modal-body p-4">
                        <div class="row">
                            @Html.HiddenFor(x => x.IdMarca)
                            @Html.HiddenFor(x => x.FechaCreacion)
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="field-1" class="control-label">Nombre Marca<span class="text-danger">*</span></label>
                                    @Html.EditorFor(x => x.NombreMarca, new { htmlAttributes = new { @class = "form-control", placeholder = "", } })
                                    @Html.ValidationMessageFor(x => x.NombreMarca, null, new { @class = "badge badge-danger" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.CheckBoxFor(x => x.Activo)<br /><label for="Activo" class="control-label">Activo<span class="text-danger"></span></label>
                                    @Html.ValidationMessageFor(x => x.Activo, null, new { @class = "badge badge-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-info waves-effect" id="cerrar" onclick="window.location.href='@Url.Action("Index", "Marcas")';">Atras</button>
                        <button data-ajax="true" data-reset="true" type="submit" class="btn btn-success waves-effect waves-light" id="guardar">Guardar</button>
                    </div>
                }
            </div>
        </div>
    </div> <!-- end card-->
</div><!-- end col -->
