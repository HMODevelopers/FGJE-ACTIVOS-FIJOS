@model List<ActivosFijos.Models.PLU_OP_Adscripcion>


@{
    ViewBag.Title = "Adscripción Empleado";
}

<div class="card">
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Corporación</th>
                    <th>Puesto</th>
                    <th>Municipio</th>
                    <th>Fecha Adscripción</th>
                    <th>Editar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdAdscripcion</td>
                        <td>@item.Corporacion</td>
                        <td>@item.PuestoFuncional</td>
                        <td>@item.PLU_CAT_Municipios.NombreMunicipio</td>
                        <td>@item.FechaInicioAdscripcion</td>
                        <td>
                            <center>
                                <a href="@Url.Action("Editar", new { id = item.IdAdscripcion })" class="btn btn-primary"><i class="icon-pencil"></i></a>
                            </center>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
        <button type="button" class="btn btn-info waves-effect" id="cerrar" onclick="window.location.href='@Url.Action("Index", "Empleados")';">Atras</button>
    </div>
</div>

