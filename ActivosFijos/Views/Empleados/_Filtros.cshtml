<div class="card-header" style="border-color: darkgray; border-style: dotted;">
    <h5>Filtros</h5>

    <div class="row">
        <div class="col-lg-12">

            @using (Ajax.BeginForm("Index", "Empleados", new AjaxOptions { HttpMethod = "GET", UpdateTargetId = "resultadosBusqueda", OnBegin = "ShowLoading", OnComplete = "HideLoading" }))
            {
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="cve_empleado" class="control-label">Clave Empleado</label>
                            <div class="input-group">
                                @Html.TextBox("CveEmpleado", null, new { @class = "form-control filtrar" })
                                <div class="input-group-append clean-filter">
                                    <span class="input-group-text">
                                        <i class="mdi mdi-close-circle text-danger"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="apePaterno" class="control-label">Apellido Paterno</label>
                            <div class="input-group">
                                @Html.TextBox("Paterno", null, new { @class = "form-control filtrar" })
                                <div class="input-group-append clean-filter">
                                    <span class="input-group-text">
                                        <i class="mdi mdi-close-circle text-danger"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="apeMaterno" class="control-label">Apellido Materno</label>
                            <div class="input-group">
                                @Html.TextBox("Materno", null, new { @class = "form-control filtrar" })
                                <div class="input-group-append clean-filter">
                                    <span class="input-group-text">
                                        <i class="mdi mdi-close-circle text-danger"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="nombre" class="control-label">Nombre</label>
                            <div class="input-group">
                                @Html.TextBox("Nombre", null, new { @class = "form-control filtrar" })
                                <div class="input-group-append clean-filter">
                                    <span class="input-group-text">
                                        <i class="mdi mdi-close-circle text-danger"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <button class="btn btn-success" id="executeButton">Actualizar Plantilla</button>
        </div>
    </div>
</div>
